# Stage 1: Build the application
FROM node:24-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3 \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11.5.2

RUN mkdir /app
WORKDIR /app
ENV PATH=/app/node_modules/.bin:$PATH

# Copy the application using Dockerfile syntax supported by the CI builder.
COPY . .
RUN pnpm install --no-frozen-lockfile

# Build the viewer with the OHIF 3.13 toolchain.
ARG APP_CONFIG=config/default.js
RUN pnpm --filter @ohif/app run build:dev

# Stage 2: Bundle the built application into a Docker container
FROM nginx:stable-alpine
ENV PORT=80
WORKDIR /app
ENV APP_GCP_URL=''
ENV APP_URL_PREFIX='airstudies-dev'

# Update packages
RUN apk -U upgrade --no-cache

# Update the package list and install dependencies
RUN apk add --no-cache python3 py3-pip curl bash aws-cli

# Check AWS CLI version
RUN aws --version

# Remove default nginx website
RUN rm -rf /usr/share/nginx/html/*

# Copy the built application
RUN rm /etc/nginx/conf.d/default.conf
COPY .docker/Viewer-v3.x/default.conf /etc/nginx/conf.d
COPY .docker/Viewer-v3.x /app
COPY --from=builder /app/platform/app/dist /usr/share/nginx/html

# Copy the entrypoint script
RUN chmod -R 777 /usr/share/nginx/html/
RUN chmod -R 777 /app/

# Start the application
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]


